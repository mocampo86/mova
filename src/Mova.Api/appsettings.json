{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "ConnectionString": "Host=localhost;Port=5432;Database=mova;Username=postgres;GSS Encryption Mode=Disable"
  },
  "Jwt": {
    "SecretKey": "",
    "Issuer": "Mova",
    "Audience": "Mova.Api",
    "ExpirationMinutes": 15
  },
  "Google": {
    "ClientId": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "CancellationPolicy": {
    "MinimumHours": 24,
    "AllowUserCancellation": true
  },
  "ErrorRateTracker": {
    "EvaluationWindow": "00:05:00",
    "MaxQueueSize": 1000
  },
  "ErrorRateHealthCheck": {
    "MaxErrorRatePerMinute": 5.0
  },
  "RateLimiting": {
    "Enabled": true,
    "Search": {
      "PermitLimit": 60,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "Login": {
      "PermitLimit": 20,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "Reservation": {
      "PermitLimit": 30,
      "WindowSeconds": 60,
      "QueueLimit": 0
    }
  }
}
